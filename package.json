	"type": "module",
	"scripts": {
		"prepare": "git config --get core.hooksPath >/dev/null || git config core.hooksPath .githooks || true",
		"docs:dev": "bun --filter @solidports/docs dev",
		"docs:react:dev": "bun run --cwd packages/base-ui/docs/react dev",
		"docs:sync": "bun packages/base-ui/scripts/docs/sync-docs-react.mjs",
		"docs:generate": "bun packages/base-ui/scripts/docs/generate-solid-docs.mjs",
		"docs:bootstrap": "bun run docs:sync && bun install && rm -rf packages/base-ui/docs/react/node_modules/@mui/internal-docs-infra/node_modules/typescript && bun run docs:generate",
		"test": "bun run --filter @solidports/recharts test",
		"test:base-ui": "bun run --filter @base-ui/monorepo test:solid:jsdom",
		"test:recharts": "bun run --filter @solidports/recharts test",
		"test:flare-ui": "bun run --filter @solidports/flare-ui test",
		"dev:flare-ui": "bun run --filter @solidports/flare-ui-consumer dev",
		"typecheck": "bun run --filter @solidports/base-ui type:check && bun run --filter @solidports/recharts type:check && bun run --filter @solidports/flare-ui type:check && bun run --filter @solidports/flare-ui-consumer type:check && bun run --filter @solidports/solid-table type:check",
		"lint": "oxlint --config .oxlintrc.json scripts",
		"lint:fix": "oxlint --config .oxlintrc.json --fix scripts",
		"fmt": "oxfmt",
		"fmt:check": "oxfmt --check",
		"test:solid-table": "bun run --filter @solidports/solid-table test",
		"dev:solid-table-examples": "bun install --cwd packages/solid-table/examples/upstream && bun run --cwd packages/solid-table/examples/upstream dev"
	},
	"devDependencies": {
		"@commitlint/cli": "21.2.1",
		"@commitlint/config-conventional": "21.2.0",
		"oxfmt": "^0.63.0",
		"oxlint": "^1.78.0"
	},
	"overrides": {
		"@solidjs/web": "2.0.0-rc.13",
		"solid-js": "2.0.0-rc.13",
		"typescript": "5.9.2"
	},
	"packageManager": "bun@1.3.11"
}
