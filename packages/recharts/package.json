{
	"author": "Lovro Žagar",
	"bugs": "https://github.com/lovrozagar/solidports/issues",
	"dependencies": {
		"clsx": "2.1.1",
		"decimal.js-light": "2.5.1",
		"es-toolkit": "1.49.0",
		"eventemitter3": "5.0.4",
		"tiny-invariant": "1.3.3",
		"victory-vendor": "37.3.6"
	},
	"description": "SolidJS 1:1 port of Recharts charting library",
	"devDependencies": {
		"@solidjs/testing-library": "0.8.10",
		"@testing-library/jest-dom": "6.9.1",
		"@types/bun": "latest",
		"@types/node": "26.1.1",
		"jsdom": "29.1.1",
		"solid-js": "1.9.14",
		"tsup": "8.5.1",
		"tsup-preset-solid": "2.2.0",
		"typescript": "7.0.2",
		"vite-plugin-solid": "2.11.12",
		"vitest": "4.1.10",
		"vitest-axe": "0.1.0"
	},
	"engines": {
		"node": ">=18"
	},
	"exports": {
		".": {
			"import": "./dist/index.js",
			"solid": "./src/index.ts",
			"types": "./dist/index.d.ts"
		}
	},
	"files": [
		"dist",
		"src",
		"README.md",
		"LICENSE",
		"NOTICE"
	],
	"homepage": "https://github.com/lovrozagar/solidports/tree/main/packages/recharts#readme",
	"keywords": [
		"solid",
		"solidjs",
		"chart",
		"charts",
		"charting",
		"recharts",
		"data-visualization"
	],
	"license": "MIT",
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"name": "@solidports/recharts",
	"peerDependencies": {
		"solid-js": ">=1.8.0"
	},
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/lovrozagar/solidports.git",
		"directory": "packages/recharts"
	},
	"scripts": {
		"build": "tsup",
		"check": "bun run typecheck && bun run lint && bun run test",
		"dev": "tsup --watch",
		"lint": "oxlint src test",
		"lint:fix": "oxlint --fix src test",
		"parity": "bun scripts/parity-audit.ts",
		"release": "bun run build && changeset publish",
		"test": "vitest run",
		"test:watch": "vitest",
		"triage": "bun scripts/triage-tests.ts",
		"type:check": "tsc --noEmit",
		"typecheck": "tsc --noEmit",
		"upstream:apply": "bun scripts/sync-upstream.ts apply",
		"upstream:diff": "bun scripts/sync-upstream.ts diff",
		"upstream:fetch": "bun scripts/sync-upstream.ts fetch",
		"upstream:pin": "bun scripts/sync-upstream.ts pin",
		"upstream:status": "bun scripts/sync-upstream.ts status"
	},
	"sideEffects": false,
	"type": "module",
	"types": "./dist/index.d.ts",
	"version": "0.1.0"
}
