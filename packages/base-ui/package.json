{
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@babel/plugin-transform-react-constant-elements": "catalog:",
    "@base-ui/monorepo-tests": "workspace:*",
    "@mui/internal-code-infra": "catalog:",
    "@mui/internal-netlify-cache": "catalog:",
    "@mui/internal-test-utils": "catalog:",
    "@next/eslint-plugin-next": "catalog:",
    "@octokit/rest": "catalog:",
    "@guidepup/guidepup": "catalog:",
    "@guidepup/playwright": "catalog:",
    "@guidepup/setup": "catalog:",
    "@playwright/test": "catalog:",
    "@tailwindcss/postcss": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/yargs": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "@vitest/coverage-istanbul": "catalog:",
    "@vitest/ui": "catalog:",
    "chai-dom": "catalog:",
    "concurrently": "catalog:",
    "cross-env": "catalog:",
    "docs": "workspace:^",
    "eslint": "catalog:",
    "eslint-plugin-solid": "catalog:",
    "execa": "catalog:",
    "globby": "catalog:",
    "lerna": "catalog:",
    "markdownlint-cli2": "catalog:",
    "prettier": "catalog:",
    "pretty-quick": "catalog:",
    "publint": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "remark-mdx": "catalog:",
    "rimraf": "catalog:",
    "serve": "catalog:",
    "stylelint": "catalog:",
    "stylelint-config-tailwindcss": "catalog:",
    "tailwindcss": "catalog:",
    "terser": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "name": "@base-ui/monorepo",
  "private": true,
  "resolutions": {
    "@babel/core": "^7.29.0",
    "@babel/plugin-transform-runtime": "^7.29.0",
    "@babel/preset-env": "^7.29.0",
    "@babel/preset-react": "^7.28.5",
    "@babel/preset-typescript": "^7.28.5",
    "@babel/types": "^7.29.0",
    "@types/node": "22.18.13",
    "@types/react": "19.2.10",
    "@types/react-dom": "^19.2.3"
  },
  "scripts": {
    "bench:solid": "node test/perf-solid/run.mjs",
    "bench:solid:build": "LIB=react vite build -c test/perf-solid/vite.config.mjs && LIB=solid vite build -c test/perf-solid/vite.config.mjs",
    "bench:solid:profile": "node test/perf-solid/profile.mjs",
    "bench:solid:ssr": "node test/perf-solid/ssr/run.mjs",
    "build": "lerna run --no-private build",
    "docs:api": "bun --filter api-docs-builder start:solid",
    "docs:build": "bun --filter @solidports/docs build",
    "docs:dev": "bun --filter @solidports/docs dev",
    "docs:generate": "bun scripts/docs/generate-solid-docs.mjs",
    "docs:preview": "bun --filter @solidports/docs preview",
    "docs:react:api": "bun --filter api-docs-builder start",
    "docs:react:build": "bun --filter docs generate-llms && bun --filter docs build && bun playground:build:export",
    "docs:react:dev": "bun run --cwd docs/react dev",
    "docs:react:generate-llms": "bun --filter docs run generate-llms",
    "docs:react:infra": "bun --filter docs run docs-infra",
    "docs:react:link-check": "bun --filter docs link-check",
    "docs:react:start": "bun --filter docs serve",
    "docs:react:validate": "bun --filter docs run internal-validate --command 'bun docs:react:validate'",
    "docs:size-why": "cross-env DOCS_STATS_ENABLED=true bun docs:react:build",
    "docs:sync": "bun scripts/docs/sync-docs-react.mjs",
    "eslint": "bun --filter '*' lint && eslint . --cache --report-unused-disable-directives --max-warnings 0",
    "eslint:ci": "bun --filter '*' lint && eslint . --report-unused-disable-directives --max-warnings 0",
    "extract-error-codes": "cross-env npm_config_package_manager_strict=false code-infra extract-error-codes --errorCodesPath docs/react/src/error-codes.json --detection opt-out",
    "inline-scripts": "tsx ./scripts/inlineScripts.mts",
    "markdownlint": "markdownlint-cli2 \"**/*.{md,mdx}\"",
    "playground:build:export": "cd playground/vite-app && cross-env PLAYGROUND_BASE=/vite-playground/ PLAYGROUND_OUT_DIR=../../docs/react/export/vite-playground bun run build",
    "prettier": "pretty-quick --ignore-path .lintignore --branch master",
    "prettier:all": "prettier --write . --ignore-path .lintignore",
    "release:build": "lerna run --concurrency 8 --no-private build --skip-nx-cache",
    "release:changelog": "code-infra generate-changelog",
    "release:changelog:docs": "FORMAT=docs code-infra generate-changelog",
    "release:publish": "code-infra publish --github-release",
    "release:publish:dry-run": "code-infra publish --github-release --dry-run ",
    "release:version": "lerna version --no-changelog --no-push --no-git-tag-version --no-private",
    "size:snapshot": "bun --filter ./test/bundle-size check",
    "size:why": "bun size:snapshot --analyze",
    "start": "bun install && bun docs:dev",
    "stylelint": "stylelint --reportInvalidScopeDisables --reportNeedlessDisables \"docs/react/**/*.{js,ts,tsx}\" \"**/*.css\" --ignore-path .lintignore",
    "test": "bun test:chromium",
    "test:_unit": "cross-env TZ=UTC vitest --project @base-ui/react --project @base-ui/utils --project docs",
    "test:argos": "code-infra argos-push --folder test/regressions/screenshots/chrome",
    "test:browsers": "cross-env VITEST_ENV=all-browsers bun test:_unit",
    "test:chromium": "cross-env VITEST_ENV=chromium bun test:_unit",
    "test:chromium:ui": "bun test:chromium --browser.headless=false",
    "test:e2e": "cross-env NODE_ENV=production bun test:e2e:build && concurrently --success first --kill-others \"bun test:e2e:run\" \"bun test:e2e:server\"",
    "test:e2e:build": "vite build --config test/e2e/vite.config.mjs",
    "test:e2e:dev": "vite --config test/e2e/vite.config.mjs -l info --port 5173",
    "test:e2e:run": "cross-env VITEST_ENV=chromium vitest run --project e2e",
    "test:e2e:server": "serve test/e2e -p 5173",
    "test:e2e:solid": "cross-env NODE_ENV=production bun test:e2e:solid:build && concurrently --success first --kill-others \"bun test:e2e:run\" \"bun test:e2e:solid:server\"",
    "test:e2e:solid:build": "vite build --config test/e2e-solid/vite.config.mjs",
    "test:e2e:solid:dev": "vite --config test/e2e-solid/vite.config.mjs -l info --port 5173",
    "test:e2e:solid:server": "serve test/e2e-solid -p 5173",
    "test:firefox": "cross-env VITEST_ENV=firefox bun test:_unit",
    "test:firefox:ui": "bun test:firefox --browser.headless=false",
    "test:jsdom": "cross-env VITEST_ENV=jsdom bun test:_unit",
    "test:jsdom:coverage": "bun test:jsdom --coverage",
    "test:lint-rules": "node scripts/eslint/testRules.test.mjs",
    "test:regressions": "cross-env NODE_ENV=production bun test:regressions:build && concurrently --success first --kill-others \"bun test:regressions:run\" \"bun test:regressions:server\"",
    "test:regressions:build": "vite build --config test/regressions/vite.config.mjs",
    "test:regressions:dev": "vite --config test/regressions/vite.config.mjs --port 5173",
    "test:regressions:run": "cross-env VITEST_ENV=chromium vitest run --project regressions",
    "test:regressions:server": "serve test/regressions -p 5173",
    "test:regressions:solid": "node test/regressions-solid/run.mjs",
    "test:regressions:solid:build": "cross-env NODE_ENV=production vite build --config test/regressions-solid/react.vite.config.mjs && cross-env NODE_ENV=production vite build --config test/regressions-solid/solid.vite.config.mjs",
    "test:regressions:solid:server": "serve test/regressions-solid/solid -p 5173",
    "pretest:screen-reader": "guidepup install",
    "test:screen-reader": "playwright test --config test/screen-reader/playwright.config.ts",
    "test:screen-reader:setup": "guidepup setup",
    "pretest:screen-reader:solid": "guidepup install",
    "test:screen-reader:solid": "playwright test --config test/screen-reader-solid/playwright.config.ts",
    "test:solid:_unit": "cross-env TZ=UTC vitest --hideSkippedTests --project @solidports/base-ui --project @solidports/base-ui:ssr --project @solidports/docs",
    "test:solid:browsers": "cross-env VITEST_ENV=all-browsers bun test:solid:_unit",
    "test:solid:chromium": "cross-env VITEST_ENV=chromium bun test:solid:_unit",
    "test:solid:chromium:ui": "bun test:solid:chromium --browser.headless=false",
    "test:solid:firefox": "cross-env VITEST_ENV=firefox bun test:solid:_unit",
    "test:solid:firefox:ui": "bun test:solid:firefox --browser.headless=false",
    "test:solid:jsdom": "cross-env VITEST_ENV=jsdom bun test:solid:_unit",
    "test:solid:jsdom:coverage": "bun test:solid:jsdom --coverage",
    "test:solid:webkit": "cross-env VITEST_ENV=webkit bun test:solid:_unit",
    "test:solid:webkit:ui": "bun test:solid:webkit --browser.headless=false",
    "test:webkit": "cross-env VITEST_ENV=webkit bun test:_unit",
    "test:webkit:ui": "bun test:webkit --browser.headless=false",
    "typescript": "tsc -b tsconfig.json",
    "use-react-18": "code-infra set-version-overrides --pkg react@18",
    "valelint": "bunx code-infra vale sync --vale-version $npm_package_config_valeVersion && git ls-files ':!docs/docs-infra' | grep -E \"\\.(md|mdx)$\" | xargs bunx code-infra vale --vale-version $npm_package_config_valeVersion --filter='.Level==\"error\"'"
  },
  "version": "1.2.0",
  "config": {
    "valeVersion": "3.24.0"
  }
}
