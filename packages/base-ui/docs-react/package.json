  "license": "MIT",
  "name": "docs-react",
  "private": true,
  "scripts": {
    "build": "rimraf ./export && cross-env NODE_ENV=production NODE_OPTIONS=--max_old_space_size=8192 next build --webpack && bun link-check",
    "build:clean": "rimraf .next && bun build",
    "deploy": "git fetch upstream master && git push -f upstream FETCH_HEAD:docs-v1",
    "dev": "next dev --webpack --port 3005",
    "docs-infra": "docs-infra",
    "generate-llms": "node ./scripts/generateLlmTxt/index.mjs",
    "internal-validate": "docs-infra validate --useVisibleDescription",
    "link-check": "tsx ./scripts/reportBrokenLinks.mts",
    "serve": "serve ./export -l 3010",
    "typescript": "tsc -b tsconfig.json",
    "validate": "bun internal-validate --command 'bun validate'"
  }
