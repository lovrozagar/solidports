{
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmit": false,
    "outDir": "build-tests",
    "rootDir": ".",
    "types": [
      "vitest/globals",
      "@types/chai",
      "@types/chai-dom"
    ]
  },
  "extends": "../../tsconfig.base.json",
  "include": [
    "src/**/*.spec.ts*",
    "src/**/*.test.ts*",
    "src/index.test.ts",
    "package.json"
  ],
  "references": [
    {
      "path": "./tsconfig.build.json"
    }
  ]
}
