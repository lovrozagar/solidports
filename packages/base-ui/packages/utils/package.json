{
  "name": "@base-ui/utils",
  "version": "0.4.0",
  "author": "MUI Team",
  "description": "A collection of React utility functions for Base UI.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mui/base-ui.git",
    "directory": "packages/utils"
  },
  "exports": {
    "./store": "./src/store/index.ts",
    "./platform": "./src/platform/index.ts",
    "./*": "./src/*.ts",
    "./*.test": null,
    "./*.spec": null
  },
  "imports": {
    "#formatErrorMessage": "./src/formatErrorMessage.ts"
  },
  "scripts": {
    "prebuild": "rimraf --glob build build-tests \"*.tsbuildinfo\"",
    "build": "code-infra build --copy .npmignore --tsgo",
    "test:package": "publint --pack bun run ./build && attw --pack ./build --exclude-entrypoints package.json",
    "release": "bun build && bun publish",
    "test": "cross-env VITEST_ENV=jsdom vitest",
    "typescript": "tsc -b tsconfig.json"
  },
  "dependencies": {
    "@babel/runtime": "catalog:",
    "@floating-ui/utils": "catalog:",
    "reselect": "catalog:",
    "use-sync-external-store": "catalog:"
  },
  "devDependencies": {
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/use-sync-external-store": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "@types/react": "^17 || ^18 || ^19",
    "react": "^17 || ^18 || ^19",
    "react-dom": "^17 || ^18 || ^19"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    }
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "directory": "build"
  }
}
