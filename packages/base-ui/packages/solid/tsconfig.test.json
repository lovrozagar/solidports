{
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmit": false,
    "outDir": "build-tests",
    "rootDir": ".",
    "skipLibCheck": true,
    "types": [
      "vitest/globals",
      "@types/chai",
      "@types/chai-dom",
      "@testing-library/jest-dom",
      "vitest/browser"
    ]
  },
  "extends": "../../tsconfig.base.json",
  "include": [
    "vitest-env.d.ts",
    "src/**/*.spec.ts*",
    "src/**/*.test.ts*",
    "src/index.test.ts",
    "test",
    "src/global.d.ts",
    "package.json",
    "eslint.config.mjs"
  ],
  "references": [
    {
      "path": "./tsconfig.build.json"
    }
  ]
}
