{
  "extends": "../../tsconfig.base.json",
  // This config emits declarations (.d.ts) only, into `types/`.
  // The package ships `src` uncompiled; consumers compile it with the Solid compiler.
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmit": false,
    "rootDir": "./src",
    "outDir": "types",
    "lib": ["ES2022", "DOM"],
    "jsx": "preserve",
    "jsxImportSource": "@solidjs/web",
    "types": ["@types/node"]
  },
  "include": ["src/**/*.ts*"],
  "exclude": [
    "src/**/*.spec.ts*",
    "src/**/*.test.ts*",
    "src/**/*.ssr-fixtures.ts*",
    "src/**/test-utils.ts*",
    "../../node_modules/@types/react"
  ],
  "references": []
}
