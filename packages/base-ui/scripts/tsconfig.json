{
  "compilerOptions": {
    "lib": [
      "ES2021"
    ],
    "module": "preserve",
    "moduleResolution": "bundler"
  },
  "exclude": [
    "**/node_modules"
  ],
  "extends": "../tsconfig.base.json",
  "include": [
    "**/*.ts",
    "**/*.mts",
    "**/*.mjs",
    "../package.json",
    "../*.mjs",
    "../*.mts"
  ]
}
