{
  "extends": "../../tsconfig.base.json",
  "include": [
    "src",
    "docs-infra/src",
    "base-ui-utils/src",
    "framework",
    "types.d.ts",
    "vite.config.ts"
  ],
  "exclude": ["node_modules", "dist"],
  "compilerOptions": {
    "allowJs": true,
    "isolatedModules": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    // Generated code reads reactive values through calls, which TypeScript does not narrow
    // (`if (x()) x().y`); the React source it comes from is checked with strict null checks.
    "strictNullChecks": false,
    "jsx": "preserve",
    "jsxImportSource": "@solidjs/web",
    "types": ["vite/client", "node"],
    "paths": {
      "@solidports/base-ui": ["../../packages/solid/src"],
      "@solidports/base-ui/*": ["../../packages/solid/src/*"],
      "@mui/internal-docs-infra/*": ["./docs-infra/src/*"],
      "@base-ui/utils/*": ["./base-ui-utils/src/*"],
      "docs/*": ["./*"]
    }
  }
}
