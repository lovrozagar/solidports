{
	"name": "@solidports/solid-table",
	"version": "0.0.1",
	"description": "Solid 2 adapter for TanStack Table. Drop-in stand-in for @tanstack/solid-table until upstream ships Solid 2 support.",
	"keywords": [
		"datagrid",
		"solid",
		"solidjs",
		"table",
		"tanstack"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/lovrozagar/solidports.git",
		"directory": "packages/solid-table"
	},
	"files": [
		"src"
	],
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": "./src/index.ts",
		"./experimental-worker-plugin": "./src/experimental-worker-plugin.ts",
		"./flex-render": "./src/flex-render.ts",
		"./static-functions": "./src/static-functions.ts",
		"./package.json": "./package.json"
	},
	"scripts": {
		"test": "vitest run && vitest run -c vitest.ssr.config.ts",
		"test:e2e": "playwright test",
		"test:prod": "NODE_ENV=production vitest run",
		"test:watch": "vitest",
		"type:check": "tsc --noEmit && tsc --noEmit -p tests/fixture"
	},
	"dependencies": {
		"@tanstack/store": "^0.11.1"
	},
	"devDependencies": {
		"@playwright/test": "catalog:",
		"@solidjs/testing-library": "catalog:",
		"@solidjs/vite-plugin": "catalog:",
		"@solidjs/web": "catalog:",
		"@tanstack/table-core": "9.2.4",
		"@types/node": "catalog:",
		"jsdom": "29.1.1",
		"solid-js": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	},
	"peerDependencies": {
		"@solidjs/web": ">=2.0.0-rc.13",
		"@tanstack/table-core": "^9.2.4",
		"solid-js": ">=2.0.0-rc.13"
	}
}
