{
	"name": "@solidports/solid-table",
	"version": "0.1.1",
	"description": "Solid 2 adapter for TanStack Table v9. Drop-in stand-in for @tanstack/solid-table until upstream supports Solid 2.",
	"keywords": [
		"datagrid",
		"headless",
		"solid",
		"solid-2",
		"solidjs",
		"table",
		"tanstack",
		"tanstack-table"
	],
	"homepage": "https://github.com/lovrozagar/solidports/tree/main/packages/solid-table#readme",
	"bugs": "https://github.com/lovrozagar/solidports/issues",
	"license": "MIT",
	"author": "Lovro Žagar",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/lovrozagar/solidports.git",
		"directory": "packages/solid-table"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE",
		"NOTICE"
	],
	"type": "module",
	"sideEffects": false,
	"main": "./dist/server/index.js",
	"module": "./dist/browser/index.js",
	"types": "./dist/types/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/types/index.d.ts",
			"solid": "./dist/solid/index.jsx",
			"worker": {
				"types": "./dist/types/index.d.ts",
				"default": "./dist/server/index.js"
			},
			"deno": {
				"types": "./dist/types/index.d.ts",
				"default": "./dist/server/index.js"
			},
			"node": {
				"types": "./dist/types/index.d.ts",
				"default": "./dist/server/index.js"
			},
			"browser": {
				"types": "./dist/types/index.d.ts",
				"default": "./dist/browser/index.js"
			},
			"default": "./dist/browser/index.js"
		},
		"./experimental-worker-plugin": {
			"types": "./dist/types/experimental-worker-plugin.d.ts",
			"solid": "./dist/solid/experimental-worker-plugin.jsx",
			"worker": {
				"types": "./dist/types/experimental-worker-plugin.d.ts",
				"default": "./dist/server/experimental-worker-plugin.js"
			},
			"deno": {
				"types": "./dist/types/experimental-worker-plugin.d.ts",
				"default": "./dist/server/experimental-worker-plugin.js"
			},
			"node": {
				"types": "./dist/types/experimental-worker-plugin.d.ts",
				"default": "./dist/server/experimental-worker-plugin.js"
			},
			"browser": {
				"types": "./dist/types/experimental-worker-plugin.d.ts",
				"default": "./dist/browser/experimental-worker-plugin.js"
			},
			"default": "./dist/browser/experimental-worker-plugin.js"
		},
		"./flex-render": {
			"types": "./dist/types/flex-render.d.ts",
			"solid": "./dist/solid/flex-render.jsx",
			"worker": {
				"types": "./dist/types/flex-render.d.ts",
				"default": "./dist/server/flex-render.js"
			},
			"deno": {
				"types": "./dist/types/flex-render.d.ts",
				"default": "./dist/server/flex-render.js"
			},
			"node": {
				"types": "./dist/types/flex-render.d.ts",
				"default": "./dist/server/flex-render.js"
			},
			"browser": {
				"types": "./dist/types/flex-render.d.ts",
				"default": "./dist/browser/flex-render.js"
			},
			"default": "./dist/browser/flex-render.js"
		},
		"./static-functions": {
			"types": "./dist/types/static-functions.d.ts",
			"solid": "./dist/solid/static-functions.jsx",
			"worker": {
				"types": "./dist/types/static-functions.d.ts",
				"default": "./dist/server/static-functions.js"
			},
			"deno": {
				"types": "./dist/types/static-functions.d.ts",
				"default": "./dist/server/static-functions.js"
			},
			"node": {
				"types": "./dist/types/static-functions.d.ts",
				"default": "./dist/server/static-functions.js"
			},
			"browser": {
				"types": "./dist/types/static-functions.d.ts",
				"default": "./dist/browser/static-functions.js"
			},
			"default": "./dist/browser/static-functions.js"
		},
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "node scripts/build.mjs",
		"prepack": "bun run build",
		"test": "vitest run && vitest run -c vitest.ssr.config.ts && vitest run -c vitest.hydration.config.ts",
		"test:e2e": "bun install --cwd tests/fixture && tsc --noEmit -p tests/fixture && playwright test",
		"test:prod": "NODE_ENV=production vitest run",
		"test:watch": "vitest",
		"type:check": "tsc --noEmit"
	},
	"devDependencies": {
		"@babel/core": "7.29.7",
		"@babel/preset-typescript": "7.29.7",
		"@playwright/test": "catalog:",
		"@solidjs/babel-plugin": "2.0.0-rc.13",
		"@solidjs/testing-library": "catalog:",
		"@solidjs/vite-plugin": "catalog:",
		"@solidjs/web": "catalog:",
		"@tanstack/store": "0.11.2",
		"@tanstack/table-core": "9.2.4",
		"@types/node": "catalog:",
		"esbuild": "0.28.2",
		"jsdom": "29.1.1",
		"solid-js": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	},
	"peerDependencies": {
		"@solidjs/web": "^2.0.0-rc.13",
		"@tanstack/table-core": "^9.2.4",
		"solid-js": "^2.0.0-rc.13"
	},
	"engines": {
		"node": ">=18"
	}
}
